<?xml version="1.0" encoding="utf-8"?>
<!-- Local dev only: provides SlopArena.Shared without GitHub Packages auth.
     CI adds the github source via workflow; this local feed is gitignored. -->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="local-sloparena" value="./.local-feed" />
  </packageSources>
</configuration>

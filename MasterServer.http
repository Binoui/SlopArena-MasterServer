@MasterServer_HostAddress = http://localhost:5000

GET {{MasterServer_HostAddress}}/health
Accept: application/json

###

###

# Guest auth → copy the token into the Bearer header below
POST {{MasterServer_HostAddress}}/auth/guest
Accept: application/json

###

# Server browser list (requires guest JWT as Bearer)
GET {{MasterServer_HostAddress}}/servers
Authorization: Bearer {{jwt}}
Accept: application/json

###

# Game server registration (upsert on ip:port) — returns serverId + apiToken
POST {{MasterServer_HostAddress}}/servers/register
Content-Type: application/json

{
  "name": "My Server",
  "ipAddress": "127.0.0.1",
  "port": 9876,
  "region": "EU",
  "isOfficial": false,
  "maxConcurrentMatches": 15
}

###

# Game server heartbeat (Bearer = apiToken from register)
POST {{MasterServer_HostAddress}}/servers/{{serverId}}/heartbeat
Authorization: Bearer {{apiToken}}
Content-Type: application/json

{
  "currentMatches": 0
}

###

# Game server deregister on shutdown (Bearer = apiToken from register)
DELETE {{MasterServer_HostAddress}}/servers/{{serverId}}
Authorization: Bearer {{apiToken}}
Accept: application/json
